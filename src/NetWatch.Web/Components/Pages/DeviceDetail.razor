@page "/devices/{Id:int}"
@attribute [Authorize]
@inject NetWatchApiClient Api

<PageTitle>Detalle de dispositivo | NetWatch</PageTitle>
@if(error is not null){<div class="alert alert-danger">@error</div>}else if(device is null){<p>Cargando...</p>}else{
 <div class="page-heading"><div><h1>@device.Name</h1><p>@DisplayLabels.DeviceType(device.DeviceType) · <code>@device.IpAddress</code> · <span class="status @device.Status.ToLowerInvariant()">@DisplayLabels.DeviceStatus(device.Status)</span></p></div><div><button class="btn btn-outline-primary" @onclick="Ping">Ejecutar ping</button> <a class="btn btn-outline-secondary" href="devices">Volver</a></div></div>
 @if(pingResult is not null){<div class="alert alert-info">@pingResult</div>}
 <div class="row g-4"><div class="col-lg-4"><section class="panel"><h2>Configuración</h2><dl><dt>Máscara</dt><dd>@device.SubnetMask</dd><dt>Puerta de enlace</dt><dd>@(device.Gateway??"-")</dd><dt>DNS</dt><dd>@(device.PrimaryDns??"-") / @(device.SecondaryDns??"-")</dd><dt>Sistema</dt><dd>@(device.OperatingSystem??"-")</dd><dt>Ubicación</dt><dd>@(device.Location??"-")</dd></dl></section></div>
 <div class="col-lg-8"><section class="panel"><h2>Métricas recientes</h2><div class="table-responsive"><table class="table"><thead><tr><th>Fecha UTC</th><th>CPU</th><th>RAM</th><th>Disco</th><th>Temp.</th><th>Tráfico</th></tr></thead><tbody>@foreach(var m in metrics){<tr><td>@m.RegisteredAtUtc.ToString("g")</td><td>@m.CpuPercent%</td><td>@m.MemoryPercent%</td><td>@m.DiskPercent%</td><td>@(m.TemperatureCelsius?.ToString("0.##")??"-")</td><td>@(m.NetworkTrafficMbps?.ToString("0.##")??"-")</td></tr>}</tbody></table></div></section></div></div>
 <section class="panel mt-4"><h2>Historial de estado</h2><div class="table-responsive"><table class="table"><thead><tr><th>Fecha UTC</th><th>Anterior</th><th>Nuevo</th><th>Motivo</th></tr></thead><tbody>@foreach(var h in history){<tr><td>@h.ChangedAtUtc.ToString("g")</td><td>@DisplayLabels.DeviceStatus(h.PreviousStatus)</td><td>@DisplayLabels.DeviceStatus(h.NewStatus)</td><td>@DisplayLabels.Text(h.Description)</td></tr>}</tbody></table></div></section>
}
@code { [Parameter]public int Id{get;set;} private DeviceDto? device;private IReadOnlyList<MetricDto> metrics=[];private IReadOnlyList<StateHistoryDto> history=[];private string? error;private string? pingResult;protected override Task OnParametersSetAsync()=>Load();private async Task Load(){try{device=await Api.GetAsync<DeviceDto>($"api/devices/{Id}");metrics=await Api.GetAsync<IReadOnlyList<MetricDto>>($"api/metrics?deviceId={Id}&limit=50");history=await Api.GetAsync<IReadOnlyList<StateHistoryDto>>($"api/devices/{Id}/history");}catch(Exception ex){error=ex.Message;}}private async Task Ping(){try{var r=await Api.PostAsync<System.Text.Json.JsonElement>($"api/diagnostics/ping/{Id}");pingResult=r.GetProperty("success").GetBoolean()?$"Respuesta correcta: {r.GetProperty("responseTimeMs").GetDouble():0.##} ms":"Sin respuesta ICMP";await Load();}catch(Exception ex){error=ex.Message;}} }
