@page "/Error"
@using System.Diagnostics

<PageTitle>Error | NetWatch</PageTitle>

<div class="error-page">
    <div><span class="error-illustration"><AppIcon Name="warning" Size="38" /></span><span class="page-eyebrow">Error del sistema</span><h1>No fue posible procesar la solicitud</h1><p>Vuelva a intentarlo. Si el problema continúa, consulte los registros de NetWatch con el identificador mostrado.</p>@if (ShowRequestId){<p><strong>Identificador de solicitud:</strong> <code>@RequestId</code></p>}<a class="btn btn-primary" href="/"><AppIcon Name="back" Size="17" /> Volver al panel</a></div>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    protected override void OnInitialized() => RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
