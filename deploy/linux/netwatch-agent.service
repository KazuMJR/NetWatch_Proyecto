[Unit]
Description=NetWatch NMS metrics agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netwatch
Group=netwatch
ExecStart=/opt/netwatch-agent/netwatch-agent /etc/netwatch/agent.json
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
