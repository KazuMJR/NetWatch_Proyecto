@page "/reports"
@attribute [Authorize]
@inject NetWatchApiClient Api
@inject IJSRuntime JS

<PageTitle>Reportes | NetWatch</PageTitle>
<div class="page-heading"><div><h1>Reportes</h1><p>Consulta histórica por dispositivo y rango de fechas</p></div></div>
@if(error is not null){<div class="alert alert-danger">@error</div>}
<section class="panel mb-4"><div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label">Tipo</label><select class="form-select" @bind="type"><option value="metrics">Métricas</option><option value="events">Eventos</option><option value="alerts">Alertas</option><option value="states">Estados</option></select></div><div class="col-md-3"><label class="form-label">Dispositivo</label><select class="form-select" @bind="deviceId"><option value="">Todos</option>@foreach(var d in devices){<option value="@d.Id">@d.Name</option>}</select></div><div class="col-md-2"><label class="form-label">Desde</label><InputDate class="form-control" @bind-Value="from" /></div><div class="col-md-2"><label class="form-label">Hasta</label><InputDate class="form-control" @bind-Value="to" /></div><div class="col-md-2"><button class="btn btn-primary me-2" @onclick="Generate">Generar</button><button class="btn btn-outline-secondary" @onclick="Download">CSV</button></div></div></section>
<section class="panel"><h2>Resultados (@rows.Count)</h2><div class="table-responsive"><table class="table"><thead><tr><th>Fecha UTC</th><th>Dispositivo</th><th>Categoría</th><th>Detalle</th><th>Valores</th></tr></thead><tbody>@foreach(var r in rows){<tr><td>@r.DateUtc.ToString("g")</td><td>@r.DeviceName</td><td>@DisplayLabels.Category(r.Category)</td><td>@DisplayLabels.Text(r.Detail)</td><td>@r.Value1 @r.Value2 @r.Value3</td></tr>}</tbody></table></div></section>
@code { private IReadOnlyList<DeviceDto>devices=[];private IReadOnlyList<ReportRowDto>rows=[];private string type="metrics";private string deviceId="";private DateTime? from=DateTime.UtcNow.Date.AddDays(-7);private DateTime? to=DateTime.UtcNow.Date.AddDays(1);private string? error;protected override async Task OnInitializedAsync(){try{devices=await Api.GetAsync<IReadOnlyList<DeviceDto>>("api/devices");await Generate();}catch(Exception ex){error=ex.Message;}}private static string Utc(DateTime? value)=>value.HasValue?DateTime.SpecifyKind(value.Value,DateTimeKind.Utc).ToString("O"):"";private string Query(string path){var d=string.IsNullOrWhiteSpace(deviceId)?"":$"&deviceId={deviceId}";return $"{path}?type={type}{d}&fromUtc={Uri.EscapeDataString(Utc(from))}&toUtc={Uri.EscapeDataString(Utc(to))}";}private async Task Generate(){try{error=null;rows=await Api.GetAsync<IReadOnlyList<ReportRowDto>>(Query("api/reports"));}catch(Exception ex){error=ex.Message;}}private async Task Download(){try{var f=await Api.DownloadAsync(Query("api/reports/csv"));await JS.InvokeVoidAsync("netwatchDownload",f.FileName,Convert.ToBase64String(f.Data));}catch(Exception ex){error=ex.Message;}} }
