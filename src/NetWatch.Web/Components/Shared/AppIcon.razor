            <><path d="m2 2 20 20M8.5 5.3A11.6 11.6 0 0 1 12 4c4 0 7.4 2 9.5 5M5 9.5A10.8 10.8 0 0 0 2.5 12M8.5 13.5A5 5 0 0 1 12 12c1 0 2 .3 2.8.8M12 20h.01" /></>
            break;
        case "pause":
            <><rect x="5" y="4" width="4" height="16" rx="1" /><rect x="15" y="4" width="4" height="16" rx="1" /></>
            break;
        case "ping":
            <><circle cx="12" cy="12" r="2" /><circle cx="12" cy="12" r="6" /><path d="M12 2a10 10 0 0 1 10 10M2 12A10 10 0 0 1 12 2M12 22A10 10 0 0 1 2 12M22 12a10 10 0 0 1-10 10" /></>
