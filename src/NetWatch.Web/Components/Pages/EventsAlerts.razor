@page "/events-alerts"
@attribute [Authorize]
@inject NetWatchApiClient Api

<PageTitle>Eventos y alertas | NetWatch</PageTitle>

<div class="page-heading">
    <div><span class="page-eyebrow">Supervisión operativa</span><h1>Eventos y alertas</h1><p>Trazabilidad de conectividad, rendimiento e incidentes detectados.</p></div>
    <div class="page-actions"><button class="btn btn-soft-primary" @onclick="Load"><AppIcon Name="refresh" Size="17" /> Actualizar datos</button></div>
</div>

@if (error is not null) { <div class="alert alert-danger"><strong>No fue posible consultar los eventos.</strong> @error</div> }

<section class="panel filter-panel mb-4">
    <div class="filter-heading"><AppIcon Name="filter" Size="17" /> Filtros de consulta</div>
    <div class="row g-3 align-items-end">
        <div class="col-md-5"><label class="form-label">Dispositivo</label><select class="form-select" @bind="deviceId"><option value="">Todos los dispositivos</option>@foreach (var device in devices){<option value="@device.Id">@device.Name · @device.IpAddress</option>}</select></div>
        <div class="col-md-4"><label class="form-label">Estado de la alerta</label><select class="form-select" @bind="alertStatus"><option value="">Todos los estados</option><option value="Pending">Pendientes</option><option value="Attended">Atendidas</option></select></div>
        <div class="col-md-3"><button class="btn btn-primary w-100" @onclick="Load"><AppIcon Name="filter" Size="16" /> Aplicar filtros</button></div>
    </div>
</section>

<div class="summary-strip mb-3">
    <span class="summary-pill">Alertas mostradas <strong>@alerts.Count</strong></span>
    <span class="summary-pill">Pendientes <strong>@alerts.Count(x => x.Status == "Pending")</strong></span>
    <span class="summary-pill">Atendidas <strong>@alerts.Count(x => x.Status == "Attended")</strong></span>
    <span class="summary-pill">Eventos mostrados <strong>@events.Count</strong></span>
</div>

<section class="panel mb-4">
    <div class="panel-header"><div class="panel-title"><span class="panel-title-icon"><AppIcon Name="alerts" Size="18" /></span><div><h2>Alertas del sistema</h2><p class="panel-subtitle">Situaciones que requieren revisión del personal técnico</p></div></div><span class="panel-count">@alerts.Count resultados</span></div>
    @if (alerts.Count == 0)
    {
        <div class="empty"><span class="empty-icon"><AppIcon Name="check" /></span>No se encontraron alertas con los filtros seleccionados.</div>
    }
    else
    {
        <div class="table-responsive"><table class="table"><thead><tr><th>Fecha UTC</th><th>Dispositivo</th><th>Alerta</th><th>Nivel</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
        @foreach (var alert in alerts)
        {
            <tr><td>@FormatDate(alert.GeneratedAtUtc)</td><td><a class="table-primary-link" href="devices/@alert.DeviceId">@alert.DeviceName</a></td><td><strong>@DisplayLabels.Text(alert.Title)</strong><span class="table-meta d-block">@DisplayLabels.Text(alert.Description)</span></td><td><span class="status @alert.Level.ToLowerInvariant()">@DisplayLabels.Severity(alert.Level)</span></td><td><span class="status @alert.Status.ToLowerInvariant()">@DisplayLabels.AlertStatus(alert.Status)</span></td><td>@if (alert.Status == "Pending"){<button class="btn btn-sm btn-soft-success" @onclick="() => Attend(alert.Id)"><AppIcon Name="check" Size="14" /> Marcar atendida</button>}else{<span class="table-meta">@FormatDate(alert.AttendedAtUtc)</span>}</td></tr>
        }
        </tbody></table></div>
    }
</section>

<section class="panel">
    <div class="panel-header"><div class="panel-title"><span class="panel-title-icon"><AppIcon Name="clock" Size="18" /></span><div><h2>Historial de eventos</h2><p class="panel-subtitle">Registro cronológico de actividad y cambios de estado</p></div></div><span class="panel-count">@events.Count resultados</span></div>
    @if (events.Count == 0)
    {
        <div class="empty"><span class="empty-icon"><AppIcon Name="clock" /></span>No se encontraron eventos para esta consulta.</div>
    }
    else
    {
        <div class="table-responsive"><table class="table"><thead><tr><th>Fecha UTC</th><th>Dispositivo</th><th>Tipo</th><th>Severidad</th><th>Descripción</th></tr></thead><tbody>@foreach (var item in events){<tr><td>@FormatDate(item.OccurredAtUtc)</td><td><a class="table-primary-link" href="devices/@item.DeviceId">@item.DeviceName</a></td><td>@DisplayLabels.EventType(item.EventType)</td><td><span class="status @item.Severity.ToLowerInvariant()">@DisplayLabels.Severity(item.Severity)</span></td><td>@DisplayLabels.Text(item.Description)</td></tr>}</tbody></table></div>
    }
</section>

@code {
    private IReadOnlyList<DeviceDto> devices = [];
    private IReadOnlyList<AlertDto> alerts = [];
    private IReadOnlyList<EventDto> events = [];
    private string deviceId = "";
    private string alertStatus = "";
    private string? error;

    protected override async Task OnInitializedAsync() { try { devices = await Api.GetAsync<IReadOnlyList<DeviceDto>>("api/devices"); await Load(); } catch (Exception ex) { error = ex.Message; } }
    private async Task Load() { try { error = null; var deviceQuery = string.IsNullOrWhiteSpace(deviceId) ? "" : $"&deviceId={deviceId}"; var statusQuery = string.IsNullOrWhiteSpace(alertStatus) ? "" : $"&status={alertStatus}"; var alertsTask = Api.GetAsync<IReadOnlyList<AlertDto>>($"api/alerts?limit=500{deviceQuery}{statusQuery}"); var eventsTask = Api.GetAsync<IReadOnlyList<EventDto>>($"api/events?limit=500{deviceQuery}"); await Task.WhenAll(alertsTask, eventsTask); alerts = await alertsTask; events = await eventsTask; } catch (Exception ex) { error = ex.Message; } }
    private async Task Attend(long id) { try { await Api.PutAsync($"api/alerts/{id}/attend"); await Load(); } catch (Exception ex) { error = ex.Message; } }
    private static string FormatDate(DateTime? value) => value?.ToString("dd/MM/yyyy HH:mm") ?? "-";
}
