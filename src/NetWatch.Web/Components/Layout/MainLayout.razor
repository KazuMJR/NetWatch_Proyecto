@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar" data-guide="navigation"><NavMenu /></aside>
    <main class="main-panel">
        <header class="topbar">
            <div class="topbar-context">
                <span class="system-pulse"></span>
                <div><strong>Centro de operaciones</strong><small>Monitoreo de infraestructura en tiempo real</small></div>
            </div>
            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="topbar-actions">
                        <GuidedTour />
                        <div class="user-summary">
                            <span class="user-avatar">@Initials(auth.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value)</span>
                            <span><strong>@auth.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value</strong><small>@DisplayLabels.Role(auth.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</small></span>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </header>
        <article class="content" data-guide="page-content">@Body</article>
    </main>
</div>
<AuthorizeView>
    <Authorized><MascotGuide AllowMenu="true" /></Authorized>
    <NotAuthorized><MascotGuide /></NotAuthorized>
</AuthorizeView>
<div id="blazor-error-ui">Ocurrió un error inesperado. <a href="" class="reload">Recargar</a><a class="dismiss">×</a></div>

@code {
    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "NW";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }
}
